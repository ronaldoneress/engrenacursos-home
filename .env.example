# ==========================================================
# Engrena Cursos - Variáveis de Ambiente de Exemplo
# ==========================================================

# Conexão com o banco de dados PostgreSQL
# Formato: postgres://<usuario>:<senha>@<host>:<porta>/<banco>?sslmode=disable
DATABASE_URL=postgres://seu_usuario:sua_senha@localhost:5432/engrena?sslmode=disable

# Porta utilizada pela aplicação (padrão 3000 em dev / 3022 em produção com Docker)
PORT=3022
